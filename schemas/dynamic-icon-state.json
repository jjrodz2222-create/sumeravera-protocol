
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DynamicIconStateEngine",
  "description": "Schema defining trigger conditions and dynamic visual state updates for mobile home screen icons.",
  "type": "object",
  "properties": {
    "app_id": {
      "type": "string",
      "description": "Target application package or bundle identifier."
    },
    "active_state_alias": {
      "type": "string",
      "description": "Current active icon asset identifier defined in the app manifest."
    },
    "trigger_event": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string" },
        "source": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical", "action_required"] },
        "timestamp": { "type": "integer" }
      },
      "required": ["event_id", "severity", "timestamp"]
    },
    "badge_configuration": {
      "type": "object",
      "properties": {
        "show_indicator": { "type": "boolean" },
        "overlay_icon_ref": { "type": "string" },
        "primary_color_hex": { "type": "string" }
      }
    }
  },
  "required": ["app_id", "active_state_alias", "trigger_event"]
} 
