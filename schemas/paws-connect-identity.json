
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PawsConnectIdentityNode",
  "description": "Species-agnostic biometric and identity schema for Paws Connect protocol nodes.",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Unique deterministic hash for the animal profile node."
    },
    "species_classification": {
      "type": "string",
      "description": "Species classification (e.g., canine, feline, equine)."
    },
    "biometric_markers": {
      "type": "object",
      "properties": {
        "primary_marking_hash": { "type": "string" },
        "chip_identifier": { "type": "string" }
      },
      "required": ["primary_marking_hash"]
    },
    "steward_signature": {
      "type": "string",
      "description": "Public key signature of the primary steward."
    },
    "immutable_ledger_record": {
      "type": "boolean",
      "default": true
    }
  },
  "required": ["node_id", "species_classification", "steward_signature"]
} 
