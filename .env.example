# ── SumerAvera Protocol — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in production values.
# NEVER commit .env to source control.

# Port overrides (optional — defaults shown)
SUMERA_PORT=3001
AVERA_PORT=3002
HONEYPOT_PORT=3003
PAWS_PORT=3004
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana admin credentials (CHANGE THESE IN PRODUCTION)
GRAFANA_USER=admin
GRAFANA_PASSWORD=<set-a-strong-password>

# Node environment
NODE_ENV=production
